{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DeliveryDb": "Host=localhost;Port=5432;Database=reservoir;Username=reservoir;Password=reservoir;Search Path=delivery"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "reservoir",
    "Password": "reservoir",
    "VirtualHost": "/",
    "Exchange": "orders.exchange",
    "DeadLetterExchange": "orders.dlx"
  },
  "DeliveryConsumer": {
    "QueueName": "delivery.queue",
    "DeadLetterQueue": "delivery.dlq",
    "ConsumesRoutingKey": "order.ready",
    "PrefetchCount": 10
  },
  "DeliverySimulator": {
    "MinDelayMs": 300,
    "MaxDelayMs": 700,
    "SuccessProbability": 1.0
  }
}
