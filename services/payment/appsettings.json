{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PaymentsDb": "Host=localhost;Port=5432;Database=reservoir;Username=reservoir;Password=reservoir;Search Path=payments"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "reservoir",
    "Password": "reservoir",
    "VirtualHost": "/",
    "Exchange": "orders.exchange",
    "DeadLetterExchange": "payment.dlx"
  },
  "PaymentConsumer": {
    "QueueName": "payment.queue",
    "DeadLetterQueue": "payment.dlq",
    "ConsumesRoutingKey": "order.created",
    "PrefetchCount": 10
  },
  "PaymentSimulator": {
    "MinDelayMs": 100,
    "MaxDelayMs": 300,
    "SuccessProbability": 1.0
  }
}
